{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent city merchant v1 primitive scenario, command and snapshot shapes",
  "$comment": "Shape documentation only; not a state authenticity checker. Runtime also enforces safe integer and no negative zero, balances <= capacities, markers <= current turn, owner/corps equality, unique IDs, non-owner hostile IDs, exact turnInputs length, full calendar/turn horizon and total budgets. Persistence reconstructs full genesis, every receipt and final snapshot. Decimal rational strings are generated internally and compared by full replay. This schema has not been executed or validated.",
  "$ref": "#/$defs/scenario",
  "$defs": {
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "enum": [
            1,
            11,
            21
          ]
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q",
        "r"
      ],
      "properties": {
        "q": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "r": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        }
      }
    },
    "corps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "forceId",
        "actionPoints"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "forceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "actionPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ownerForceId",
        "position",
        "gold",
        "goldCapacity",
        "food",
        "foodCapacity",
        "merchantPresent",
        "uiTradePrice",
        "merchantUsedTurn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "kind": {
          "const": "city"
        },
        "ownerForceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "goldCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "food": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "foodCapacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "merchantPresent": {
          "type": "boolean"
        },
        "uiTradePrice": {
          "enum": [
            3,
            4,
            5,
            6,
            7
          ]
        },
        "merchantUsedTurn": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "officer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "forceId",
        "cityId",
        "available",
        "politics",
        "politicsXp",
        "actedTurn"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "forceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "cityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "available": {
          "type": "boolean"
        },
        "politics": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100
        },
        "politicsXp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "actedTurn": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    },
    "fieldUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "forceId",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "forceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "turnInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merchantPresent",
        "uiTradePrice",
        "fieldUnits"
      ],
      "properties": {
        "merchantPresent": {
          "type": "boolean"
        },
        "uiTradePrice": {
          "enum": [
            3,
            4,
            5,
            6,
            7
          ]
        },
        "fieldUnits": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/fieldUnit"
          }
        }
      }
    },
    "policies": {
      "enum": [
        {
          "version": "city-merchant-policies-v1",
          "calendar": {
            "id": "finite-merchant-ten-day-calendar-v1",
            "days": [
              1,
              11,
              21
            ],
            "minYear": 1,
            "maxYear": 9999,
            "maxAdvanceLimit": 360,
            "advanceCountPerCommand": 1,
            "creationTrades": 0
          },
          "ownership": {
            "id": "merchant-fixed-owned-city-v1",
            "cityKind": "city",
            "activeOwnerCorpsMustMatch": true,
            "ownershipChanges": false
          },
          "eligibility": {
            "id": "merchant-once-city-actor-turn-v1",
            "cityTradesPerTurn": 1,
            "actorsPerTrade": 1,
            "actorMustBeAvailable": true,
            "actorMustMatchCityAndForce": true,
            "actionPointsCost": 20,
            "fixedGoldFee": 0,
            "minFoodAmount": 1,
            "maxFoodAmount": 1000000000
          },
          "hostility": {
            "id": "supplied-axial-distance-v1",
            "completeFieldUnitsRequired": true,
            "hostileForceIdsExplicit": true,
            "differentForceImpliesHostile": false,
            "distance": "max(abs(dq),abs(dr),abs(dq+dr))",
            "blockingDistanceInclusive": 2,
            "coordinateMin": -1000000,
            "coordinateMax": 1000000,
            "nativeGeometryRecovered": false
          },
          "pricing": {
            "id": "merchant-ui-rational-rounding-v1",
            "priceScale": "ui-food-per-gold",
            "uiTradePrices": [
              3,
              4,
              5,
              6,
              7
            ],
            "rawTradePriceAccepted": false,
            "requestUnit": "food",
            "buyGold": "ceil(Q*D/(uiPrice*N))",
            "sellGold": "floor(Q*N*4/(uiPrice*D*5))",
            "buyFactor": {
              "numerator": 1,
              "denominator": 1
            },
            "sellFactor": {
              "numerator": 4,
              "denominator": 5
            },
            "interpolation": "exact-unreduced-rational-v1",
            "goldFraction": "unreduced-nonnegative-decimal-strings-v1",
            "nativeRoundingRecovered": false
          },
          "zeroSale": {
            "id": "reject-zero-value-sale-v1",
            "minimumGoldCredit": 1
          },
          "capacity": {
            "id": "merchant-full-fill-cap-reject-v1",
            "maxBalanceAndCapacity": 1000000000,
            "partialFill": false,
            "discarded": 0,
            "failure": "atomic-reject"
          },
          "rewards": {
            "id": "merchant-politics-xp5-no-growth-v1",
            "politicsXpRequested": 5,
            "politicsXpCap": 1000000000,
            "automaticPoliticsGrowth": false,
            "meritDelta": 0,
            "techniquePointsDelta": 0,
            "loyaltyDelta": 0,
            "meritApplication": "not-integrated-profile-zero",
            "nativeMeritRewardRecovered": false
          },
          "inputs": {
            "id": "merchant-fixed-external-turn-inputs-v1",
            "exactAdvanceLimitItems": true,
            "fields": [
              "merchantPresent",
              "uiTradePrice",
              "fieldUnits"
            ],
            "missing": "reject",
            "nativeMerchantProbability": false,
            "nativePriceTransition": false,
            "nativeUnitMovement": false,
            "rngDraws": 0
          },
          "budget": {
            "id": "merchant-bounded-json-v1",
            "maxOfficers": 256,
            "maxFieldUnits": 4096,
            "maxHostileForces": 256,
            "maxAcceptedCommands": 721,
            "maxTraceAttempts": 2163,
            "maxCanonicalUtf8Bytes": 67108864,
            "maxInputNodes": 4000000,
            "maxInputDepth": 48,
            "maxArrayLength": 4096,
            "maxObjectKeys": 128,
            "maxIdLength": 64
          },
          "persistence": {
            "id": "merchant-canonical-recompute-v1",
            "schemaVersion": 1,
            "policyComparison": "full-parameters",
            "catalogComparison": "full-snapshot",
            "digest": "sha256-canonical-json",
            "genesisSnapshot": "recompute",
            "receipts": "compare-all-fields",
            "finalSnapshot": "compare-all-fields",
            "jsonDuplicateKeys": "reject",
            "objectKeyOrder": "irrelevant",
            "arrayOrder": "preserved"
          },
          "apRecovery": {
            "id": "merchant-service-ap-recovery20-v1",
            "perAdvance": 20,
            "cap": 255,
            "nativeApFormula": false
          }
        },
        {
          "version": "city-merchant-policies-v1",
          "calendar": {
            "id": "finite-merchant-ten-day-calendar-v1",
            "days": [
              1,
              11,
              21
            ],
            "minYear": 1,
            "maxYear": 9999,
            "maxAdvanceLimit": 360,
            "advanceCountPerCommand": 1,
            "creationTrades": 0
          },
          "ownership": {
            "id": "merchant-fixed-owned-city-v1",
            "cityKind": "city",
            "activeOwnerCorpsMustMatch": true,
            "ownershipChanges": false
          },
          "eligibility": {
            "id": "merchant-once-city-actor-turn-v1",
            "cityTradesPerTurn": 1,
            "actorsPerTrade": 1,
            "actorMustBeAvailable": true,
            "actorMustMatchCityAndForce": true,
            "actionPointsCost": 20,
            "fixedGoldFee": 0,
            "minFoodAmount": 1,
            "maxFoodAmount": 1000000000
          },
          "hostility": {
            "id": "supplied-axial-distance-v1",
            "completeFieldUnitsRequired": true,
            "hostileForceIdsExplicit": true,
            "differentForceImpliesHostile": false,
            "distance": "max(abs(dq),abs(dr),abs(dq+dr))",
            "blockingDistanceInclusive": 2,
            "coordinateMin": -1000000,
            "coordinateMax": 1000000,
            "nativeGeometryRecovered": false
          },
          "pricing": {
            "id": "merchant-ui-rational-rounding-v1",
            "priceScale": "ui-food-per-gold",
            "uiTradePrices": [
              3,
              4,
              5,
              6,
              7
            ],
            "rawTradePriceAccepted": false,
            "requestUnit": "food",
            "buyGold": "ceil(Q*D/(uiPrice*N))",
            "sellGold": "floor(Q*N*4/(uiPrice*D*5))",
            "buyFactor": {
              "numerator": 1,
              "denominator": 1
            },
            "sellFactor": {
              "numerator": 4,
              "denominator": 5
            },
            "interpolation": "exact-unreduced-rational-v1",
            "goldFraction": "unreduced-nonnegative-decimal-strings-v1",
            "nativeRoundingRecovered": false
          },
          "zeroSale": {
            "id": "reject-zero-value-sale-v1",
            "minimumGoldCredit": 1
          },
          "capacity": {
            "id": "merchant-full-fill-cap-reject-v1",
            "maxBalanceAndCapacity": 1000000000,
            "partialFill": false,
            "discarded": 0,
            "failure": "atomic-reject"
          },
          "rewards": {
            "id": "merchant-politics-xp5-no-growth-v1",
            "politicsXpRequested": 5,
            "politicsXpCap": 1000000000,
            "automaticPoliticsGrowth": false,
            "meritDelta": 0,
            "techniquePointsDelta": 0,
            "loyaltyDelta": 0,
            "meritApplication": "not-integrated-profile-zero",
            "nativeMeritRewardRecovered": false
          },
          "inputs": {
            "id": "merchant-fixed-external-turn-inputs-v1",
            "exactAdvanceLimitItems": true,
            "fields": [
              "merchantPresent",
              "uiTradePrice",
              "fieldUnits"
            ],
            "missing": "reject",
            "nativeMerchantProbability": false,
            "nativePriceTransition": false,
            "nativeUnitMovement": false,
            "rngDraws": 0
          },
          "budget": {
            "id": "merchant-bounded-json-v1",
            "maxOfficers": 256,
            "maxFieldUnits": 4096,
            "maxHostileForces": 256,
            "maxAcceptedCommands": 721,
            "maxTraceAttempts": 2163,
            "maxCanonicalUtf8Bytes": 67108864,
            "maxInputNodes": 4000000,
            "maxInputDepth": 48,
            "maxArrayLength": 4096,
            "maxObjectKeys": 128,
            "maxIdLength": 64
          },
          "persistence": {
            "id": "merchant-canonical-recompute-v1",
            "schemaVersion": 1,
            "policyComparison": "full-parameters",
            "catalogComparison": "full-snapshot",
            "digest": "sha256-canonical-json",
            "genesisSnapshot": "recompute",
            "receipts": "compare-all-fields",
            "finalSnapshot": "compare-all-fields",
            "jsonDuplicateKeys": "reject",
            "objectKeyOrder": "irrelevant",
            "arrayOrder": "preserved"
          },
          "apRecovery": {
            "id": "merchant-service-ap-recovery0-v1",
            "perAdvance": 0,
            "cap": 255,
            "nativeApFormula": false
          }
        }
      ]
    },
    "catalog": {
      "const": {
        "version": "merchant-politics-observed-linear-v1",
        "evidence": "selected-approximate-observations-not-native-exact",
        "minPolitics": 20,
        "maxPolitics": 100,
        "anchorDenominator": 1000000,
        "anchors": [
          {
            "politics": 20,
            "effectMillionths": 930240
          },
          {
            "politics": 50,
            "effectMillionths": 1000000
          },
          {
            "politics": 51,
            "effectMillionths": 1002516
          },
          {
            "politics": 60,
            "effectMillionths": 1025650
          },
          {
            "politics": 70,
            "effectMillionths": 1052642
          },
          {
            "politics": 80,
            "effectMillionths": 1081090
          },
          {
            "politics": 90,
            "effectMillionths": 1111122
          },
          {
            "politics": 92,
            "effectMillionths": 1117328
          },
          {
            "politics": 97,
            "effectMillionths": 1133154
          },
          {
            "politics": 98,
            "effectMillionths": 1136374
          },
          {
            "politics": 99,
            "effectMillionths": 1139612
          },
          {
            "politics": 100,
            "effectMillionths": 1142868
          }
        ],
        "betweenAnchors": "N=A_l*(h-p)+A_h*(p-l);D=1000000*(h-l)",
        "anchorFraction": "N=A_p;D=1000000",
        "reduction": "unreduced",
        "outsideRange": "reject"
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profile",
        "date",
        "turn",
        "advanceLimit",
        "activeForceId",
        "corps",
        "city",
        "officers",
        "hostileForceIds",
        "completeFieldUnits",
        "fieldUnits",
        "turnInputs",
        "policies",
        "catalog"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "profile": {
          "const": "standalone-city-merchant-v1"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "advanceLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "activeForceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "corps": {
          "$ref": "#/$defs/corps"
        },
        "city": {
          "$ref": "#/$defs/city"
        },
        "officers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/officer"
          }
        },
        "hostileForceIds": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
          },
          "uniqueItems": true
        },
        "completeFieldUnits": {
          "const": true
        },
        "fieldUnits": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/fieldUnit"
          }
        },
        "turnInputs": {
          "type": "array",
          "maxItems": 360,
          "items": {
            "$ref": "#/$defs/turnInput"
          },
          "minItems": 1
        },
        "policies": {
          "$ref": "#/$defs/policies"
        },
        "catalog": {
          "$ref": "#/$defs/catalog"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cityId",
            "officerId",
            "foodAmount"
          ],
          "properties": {
            "type": {
              "enum": [
                "BuyFood",
                "SellFood"
              ]
            },
            "cityId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            "officerId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
            },
            "foodAmount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "AdvanceMerchantTurn"
            }
          }
        }
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedRevision",
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 721
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "profile",
        "revision",
        "advancedCount",
        "date",
        "turn",
        "corps",
        "city",
        "officers",
        "completeFieldUnits",
        "fieldUnits"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "profile": {
          "const": "standalone-city-merchant-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 721
        },
        "advancedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 360
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "corps": {
          "$ref": "#/$defs/corps"
        },
        "city": {
          "$ref": "#/$defs/city"
        },
        "officers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/officer"
          }
        },
        "completeFieldUnits": {
          "const": true
        },
        "fieldUnits": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/fieldUnit"
          }
        }
      }
    }
  }
}
