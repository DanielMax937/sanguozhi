{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/san11/ps2-historical/schema.json",
  "title": "Independent inert PS2 historical guide schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "const": "san11.ps2-historical.atwiki100.20261007"
    },
    "sourceId": {
      "const": "atwiki-100-ps2"
    },
    "sourceURL": {
      "const": "https://w.atwiki.jp/sangokushi11/pages/100.html"
    },
    "snapshotSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "const": "public-guide-transcription"
    },
    "executionEnabled": {
      "const": false
    },
    "conditionMeaning": {
      "const": "Missing source conditions mean not stated, never unconditional eligibility. Clauses are descriptive and have no evaluator."
    },
    "resultOrderMeaning": {
      "const": "Source-description order and rendered indentation only; not native store/callback order or a resolved execution tree."
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^ps2\\.historical\\.[0-9]{2}$"
          },
          "observationId": {
            "type": "string",
            "pattern": "^ps2\\.atwiki100\\.[0-9]{2}$"
          },
          "sourceOrdinal": {
            "type": "integer",
            "minimum": 1
          },
          "sourceSection": {
            "type": "string",
            "minLength": 1
          },
          "sourceLocator": {
            "type": "object",
            "properties": {
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "startLine",
              "endLine"
            ],
            "additionalProperties": false
          },
          "versionScope": {
            "type": "object",
            "properties": {
              "platform": {
                "const": "PS2"
              },
              "edition": {
                "const": "unspecified"
              },
              "patch": {
                "type": "null"
              },
              "editionBasis": {
                "const": "rendered-text-lacks-color"
              }
            },
            "required": [
              "platform",
              "edition",
              "patch",
              "editionBasis"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "const": "public-guide-transcription"
          },
          "executionEnabled": {
            "const": false
          },
          "nativeEventId": {
            "type": "null"
          },
          "onceOnly": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not-stated"
              },
              "flagId": {
                "type": "null"
              }
            },
            "required": [
              "status",
              "flagId"
            ],
            "additionalProperties": false
          },
          "triggerProbability": {
            "type": "null"
          },
          "coverageKind": {
            "enum": [
              "conditions-and-results",
              "conditions-only",
              "reference-only"
            ]
          },
          "conditionCompleteness": {
            "enum": [
              "partial-source-description",
              "not-stated"
            ]
          },
          "resultCompleteness": {
            "enum": [
              "partial-source-description",
              "not-stated"
            ]
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "sourceLineSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0
                },
                "parentLine": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ]
                },
                "role": {
                  "enum": [
                    "condition-label",
                    "result-label",
                    "condition",
                    "result",
                    "reference",
                    "annotation"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "source-stated",
                    "source-ambiguous",
                    "source-uncertain",
                    "source-editorial"
                  ]
                }
              },
              "required": [
                "sourceLine",
                "sourceLineSha256",
                "depth",
                "parentLine",
                "role",
                "text",
                "certainty"
              ],
              "additionalProperties": false
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceLine": {
                  "type": "integer",
                  "minimum": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "not-transcribed"
                }
              },
              "required": [
                "sourceLine",
                "label",
                "url",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "eventId",
          "observationId",
          "sourceOrdinal",
          "sourceSection",
          "sourceLocator",
          "versionScope",
          "evidence",
          "executionEnabled",
          "nativeEventId",
          "onceOnly",
          "triggerProbability",
          "coverageKind",
          "conditionCompleteness",
          "resultCompleteness",
          "clauses",
          "references"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetId",
    "sourceId",
    "sourceURL",
    "snapshotSha256",
    "evidence",
    "executionEnabled",
    "conditionMeaning",
    "resultOrderMeaning",
    "observations"
  ],
  "additionalProperties": false
}
