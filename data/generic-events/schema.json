                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "source-stated",
                    "source-uncertain",
                    "source-unverified",
                    "source-ambiguous"
                  ]
                },
                "sourceLocator": {
                  "type": "object",
                  "properties": {
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                },
                "quantities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "enum": [
                          "gte",
                          "lt",
                          "eq",
                          "delta",
                          "one-of",
                          "range-inclusive",
                          "unknown",
                          "qualitative"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "minItems": 1
                          }
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "operator",
                      "value",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "scope",
                "text",
                "certainty",
                "sourceLocator",
                "quantities"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "source-stated",
                    "source-uncertain",
                    "source-unverified",
                    "source-ambiguous"
                  ]
                },
                "sourceLocator": {
                  "type": "object",
                  "properties": {
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                },
                "quantities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "enum": [
                          "gte",
                          "lt",
                          "eq",
                          "delta",
                          "one-of",
                          "range-inclusive",
                          "unknown",
                          "qualitative"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "minItems": 1
                          }
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "operator",
                      "value",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "scope",
                "text",
                "certainty",
                "sourceLocator",
                "quantities"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "eventId",
          "observationId",
          "sourceId",
          "sourceURL",
          "sourceSection",
          "sourceOrdinal",
          "ordinalScope",
          "sourceLocator",
          "snapshotSha256",
          "evidence",
          "executionEnabled",
          "coverageKind",
          "nativeEventId",
          "onceOnly",
          "triggerProbability",
          "conditionCompleteness",
          "resultCompleteness",
          "conditions",
          "results",
          "annotations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
