{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/san11/generic-events/schema.json",
  "title": "Inert generic-event source schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "enum": [
        "san11.generic.atwiki88.20261007",
        "san11.generic.gamersky2009.20261007"
      ]
    },
    "evidence": {
      "const": "public-guide-transcription"
    },
    "executionEnabled": {
      "const": false
    },
    "versionScope": {
      "type": "object",
      "properties": {
        "edition": {
          "enum": [
            "unspecified",
            "PK"
          ]
        },
        "platform": {
          "type": "null"
        },
        "patch": {
          "type": "null"
        },
        "basis": {
          "enum": [
            "article-title-and-introduction",
            "not-stated"
          ]
        }
      },
      "required": [
        "edition",
        "platform",
        "patch",
        "basis"
      ],
      "additionalProperties": false
    },
    "conditionMeaning": {
      "const": "Source descriptions only. Missing conditions mean not stated, never unconditional eligibility or negative evidence."
    },
    "resultOrderMeaning": {
      "const": "Guide-description order only, not native stores or callback order."
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^generic\\.[a-z][a-z0-9-]*$"
          },
          "observationId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^generic\\.(atwiki88\\.[0-9]{2}|gamersky2009\\.(01\\.bronze-sparrow|13\\.taishan))$"
          },
          "sourceId": {
            "enum": [
              "atwiki-88-generic",
              "gamersky-2009-01",
              "gamersky-2009-13"
            ]
          },
          "sourceURL": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://"
          },
          "sourceSection": {
            "type": "string",
            "minLength": 1
          },
          "sourceOrdinal": {
            "type": "integer",
            "minimum": 1
          },
          "ordinalScope": {
            "enum": [
              "selected-generic-section",
              "selected-observations-on-page"
            ]
          },
          "sourceLocator": {
            "type": "object",
            "properties": {
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "startLine",
              "endLine"
            ],
            "additionalProperties": false
          },
          "snapshotSha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence": {
            "const": "public-guide-transcription"
          },
          "executionEnabled": {
            "const": false
          },
          "coverageKind": {
            "enum": [
              "substantive",
              "conditions-only",
              "unverified-anecdote",
              "qualitative-result-only",
              "heading-only",
              "supplementary"
            ]
          },
          "nativeEventId": {
            "type": "null"
          },
          "onceOnly": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not-stated"
              },
              "flagId": {
                "type": "null"
              }
            },
            "required": [
              "status",
              "flagId"
            ],
            "additionalProperties": false
          },
          "triggerProbability": {
            "type": "null"
          },
          "conditionCompleteness": {
            "enum": [
              "not-stated",
              "partial-source-description"
            ]
          },
          "resultCompleteness": {
            "enum": [
              "not-stated",
              "partial-source-description"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "certainty": {
                  "enum": [
                    "source-stated",
                    "source-uncertain",
                    "source-unverified",
                    "source-ambiguous"
                  ]
                },
                "sourceLocator": {
                  "type": "object",
                  "properties": {
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "startLine",
                    "endLine"
                  ],
                  "additionalProperties": false
                },
                "quantities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operator": {
                        "enum": [
                          "gte",
                          "lt",
                          "eq",
                          "delta",
                          "one-of",
                          "range-inclusive",
                          "unknown",
                          "qualitative"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "minItems": 1
                          }
                        ]
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "operator",
                      "value",
                      "unit"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "scope",
                "text",
                "certainty",
                "sourceLocator",
                "quantities"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
