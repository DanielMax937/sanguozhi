      "changes": {
        "hp": [
          1000,
          -99
        ]
      },
      "expectedReason": "choice-forbidden"
    },
    {
      "id": "disabled-choice",
      "changes": {
        "criticalDisabled": true
      },
      "expectedReason": "choice-forbidden"
    },
    {
      "id": "output-enum-as-choice",
      "changes": {
        "choice": 2
      },
      "expectedReason": "invalid-choice"
    },
    {
      "id": "choice-minus-one",
      "changes": {
        "choice": -1
      },
      "expectedReason": "invalid-choice"
    },
    {
      "id": "choice-string",
      "changes": {
        "choice": "PushOn"
      },
      "expectedReason": "invalid-choice"
    },
    {
      "id": "winner-unresolved",
      "changes": {
        "winner": -1
      },
