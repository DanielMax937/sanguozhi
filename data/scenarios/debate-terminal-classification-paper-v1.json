    },
    {
      "id": "policy-patch",
      "changes": {
        "notation": "只提供policy.id或修改normalPolicy"
      },
      "expectedReason": "unsupported-policy"
    },
    {
      "id": "wrong-profile",
      "changes": {
        "profile": "other"
      },
      "expectedReason": "unsupported-profile"
    },
    {
      "id": "unsafe-numeric",
      "changes": {
        "notation": "hp内NaN/Infinity/小数/负零/unsafe integer"
      },
      "expectedReason": "malformed-data"
    },
    {
      "id": "executable-input",
      "changes": {
        "notation": "getter/函数/Proxy/cycle/symbol/类实例"
      },
      "expectedReason": "malformed-data"
    },
    {
      "id": "sparse-array",
      "changes": {
        "notation": "hp含空洞或额外属性"
      },
      "expectedReason": "malformed-data"
    },
    {
      "id": "budget",
      "changes": {
        "notation": "任意输入超过节点/深度/数组/UTF-8预算"
      },
      "expectedReason": "input-limit"
