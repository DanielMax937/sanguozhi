        },
        "pointerStatus": {
          "enum": [
            "provided",
            "omitted-too-long",
            "omitted-output-budget"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "pointerStatus": {
                "const": "provided"
              }
            }
          },
          "then": {
            "properties": {
              "inputJSONPointer": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "inputJSONPointer": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "observationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "sourcePath",
        "gitBlobSha",
        "sha256",
        "observationId"
      ],
      "properties": {
        "family": {
          "enum": [
            "generic-events",
            "scenario-events",
            "ps2-scenario-events"
          ]
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "gitBlobSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "observationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}(?![\\s\\S])"
        }
      }
    },
    "targetVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "platform",
        "patch"
      ],
      "properties": {
        "edition": {
          "enum": [
            "PK",
            "Vanilla",
            null
          ]
        },
        "platform": {
          "enum": [
            "PC",
            "PS2",
            "Wii",
            null
          ]
        },
        "patch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          ]
        }
      }
    }
  }
}
