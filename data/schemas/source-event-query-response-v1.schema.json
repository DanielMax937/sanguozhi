      "$ref": "#/$defs/querySuccess"
    },
    {
      "$ref": "#/$defs/profileSuccess"
    },
    {
      "$ref": "#/$defs/listSuccess"
    },
    {
      "$ref": "#/$defs/failure"
    }
  ],
